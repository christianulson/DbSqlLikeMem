{
  "name": "dbsqllikemem-vscode-extension",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.3.0",
  "publisher": "dbsqllikemem",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/christianulson/DbSqlLikeMem.git"
  },
  "bugs": {
    "url": "https://github.com/christianulson/DbSqlLikeMem/issues"
  },
  "homepage": "https://github.com/christianulson/DbSqlLikeMem#readme",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#1f2937",
    "theme": "dark"
  },
  "keywords": [
    "dbsqllikemem",
    "database",
    "sql",
    "poco",
    "code-generation"
  ],
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:dbSqlLikeMem.addConnection",
    "onCommand:dbSqlLikeMem.checkConsistency",
    "onCommand:dbSqlLikeMem.configureMappings",
    "onCommand:dbSqlLikeMem.configureTemplates",
    "onCommand:dbSqlLikeMem.generateClasses",
    "onCommand:dbSqlLikeMem.generateModelClasses",
    "onCommand:dbSqlLikeMem.generateRepositoryClasses",
    "onCommand:dbSqlLikeMem.openManager",
    "onView:dbSqlLikeMem.connections",
    "onCommand:dbSqlLikeMem.editConnection",
    "onCommand:dbSqlLikeMem.removeConnection",
    "onCommand:dbSqlLikeMem.refresh",
    "onCommand:dbSqlLikeMem.exportState",
    "onCommand:dbSqlLikeMem.importState",
    "onCommand:dbSqlLikeMem.setFilter"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbSqlLikeMem",
          "title": "%viewsContainer.title%",
          "icon": "resources/database.svg"
        }
      ]
    },
    "views": {
      "dbSqlLikeMem": [
        {
          "id": "dbSqlLikeMem.connections",
          "name": "%views.connections.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "dbSqlLikeMem.openManager",
        "title": "%command.openManager.title%",
        "icon": "$(database)"
      },
      {
        "command": "dbSqlLikeMem.addConnection",
        "title": "%command.addConnection.title%",
        "icon": "$(add)"
      },
      {
        "command": "dbSqlLikeMem.configureMappings",
        "title": "%command.configureMappings.title%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "dbSqlLikeMem.generateClasses",
        "title": "%command.generateClasses.title%",
        "icon": "$(gear)"
      },
      {
        "command": "dbSqlLikeMem.generateModelClasses",
        "title": "%command.generateModelClasses.title%",
        "icon": "$(symbol-class)"
      },
      {
        "command": "dbSqlLikeMem.generateRepositoryClasses",
        "title": "%command.generateRepositoryClasses.title%",
        "icon": "$(repo)"
      },
      {
        "command": "dbSqlLikeMem.configureTemplates",
        "title": "%command.configureTemplates.title%",
        "icon": "$(file)"
      },
      {
        "command": "dbSqlLikeMem.checkConsistency",
        "title": "%command.checkConsistency.title%",
        "icon": "$(check)"
      },
      {
        "command": "dbSqlLikeMem.refresh",
        "title": "%command.refresh.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "dbSqlLikeMem.exportState",
        "title": "%command.exportState.title%",
        "icon": "$(export)"
      },
      {
        "command": "dbSqlLikeMem.importState",
        "title": "%command.importState.title%",
        "icon": "$(import)"
      },
      {
        "command": "dbSqlLikeMem.setFilter",
        "title": "%command.setFilter.title%",
        "icon": "$(filter)"
      },
      {
        "command": "dbSqlLikeMem.editConnection",
        "title": "%command.editConnection.title%",
        "icon": "$(edit)"
      },
      {
        "command": "dbSqlLikeMem.removeConnection",
        "title": "%command.removeConnection.title%",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dbSqlLikeMem.openManager",
          "when": "view == dbSqlLikeMem.connections",
          "group": "navigation@0"
        },
        {
          "command": "dbSqlLikeMem.addConnection",
          "when": "view == dbSqlLikeMem.connections",
          "group": "navigation"
        },
        {
          "command": "dbSqlLikeMem.refresh",
          "when": "view == dbSqlLikeMem.connections",
          "group": "navigation"
        },
        {
          "command": "dbSqlLikeMem.setFilter",
          "when": "view == dbSqlLikeMem.connections",
          "group": "navigation"
        },
        {
          "command": "dbSqlLikeMem.configureTemplates",
          "when": "view == dbSqlLikeMem.connections",
          "group": "navigation"
        },
        {
          "command": "dbSqlLikeMem.exportState",
          "when": "view == dbSqlLikeMem.connections",
          "group": "navigation@8"
        },
        {
          "command": "dbSqlLikeMem.importState",
          "when": "view == dbSqlLikeMem.connections",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        {
          "command": "dbSqlLikeMem.configureMappings",
          "when": "view == dbSqlLikeMem.connections && viewItem == db-database",
          "group": "inline@0"
        },
        {
          "command": "dbSqlLikeMem.generateClasses",
          "when": "view == dbSqlLikeMem.connections && viewItem == db-database",
          "group": "inline@1"
        },
        {
          "command": "dbSqlLikeMem.generateModelClasses",
          "when": "view == dbSqlLikeMem.connections && viewItem == db-database",
          "group": "inline@2"
        },
        {
          "command": "dbSqlLikeMem.generateRepositoryClasses",
          "when": "view == dbSqlLikeMem.connections && viewItem == db-database",
          "group": "inline@3"
        },
        {
          "command": "dbSqlLikeMem.checkConsistency",
          "when": "view == dbSqlLikeMem.connections && viewItem == db-database",
          "group": "inline@4"
        },
        {
          "command": "dbSqlLikeMem.removeConnection",
          "when": "view == dbSqlLikeMem.connections && viewItem == db-database",
          "group": "inline@5"
        },
        {
          "command": "dbSqlLikeMem.editConnection",
          "when": "view == dbSqlLikeMem.connections && viewItem == db-database",
          "group": "1_connection"
        },
        {
          "command": "dbSqlLikeMem.removeConnection",
          "when": "view == dbSqlLikeMem.connections && viewItem == db-database",
          "group": "1_connection@1"
        },
        {
          "command": "dbSqlLikeMem.generateClasses",
          "when": "view == dbSqlLikeMem.connections && viewItem == db-objectType",
          "group": "inline@0"
        },
        {
          "command": "dbSqlLikeMem.checkConsistency",
          "when": "view == dbSqlLikeMem.connections && viewItem == db-objectType",
          "group": "inline@3"
        },
        {
          "command": "dbSqlLikeMem.generateClasses",
          "when": "view == dbSqlLikeMem.connections && viewItem == db-object",
          "group": "inline@0"
        },
        {
          "command": "dbSqlLikeMem.generateModelClasses",
          "when": "view == dbSqlLikeMem.connections && viewItem == db-object",
          "group": "inline@1"
        },
        {
          "command": "dbSqlLikeMem.generateRepositoryClasses",
          "when": "view == dbSqlLikeMem.connections && viewItem == db-object",
          "group": "inline@2"
        },
        {
          "command": "dbSqlLikeMem.checkConsistency",
          "when": "view == dbSqlLikeMem.connections && viewItem == db-object",
          "group": "inline@3"
        },
        {
          "command": "dbSqlLikeMem.generateModelClasses",
          "when": "view == dbSqlLikeMem.connections && viewItem == db-objectType",
          "group": "inline@1"
        },
        {
          "command": "dbSqlLikeMem.generateRepositoryClasses",
          "when": "view == dbSqlLikeMem.connections && viewItem == db-objectType",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "dbSqlLikeMem.openManager"
        },
        {
          "command": "dbSqlLikeMem.exportState"
        },
        {
          "command": "dbSqlLikeMem.importState"
        },
        {
          "command": "dbSqlLikeMem.configureMappings"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dbSqlLikeMem.connections",
        "contents": "%views.welcome%"
      }
    ]
  },
  "scripts": {
    "compile:bridge": "node ./scripts/build-bridge.js",
    "compile": "npm run compile:bridge && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run generate:icon && npm run compile",
    "lint": "tsc -p ./ --noEmit",
    "test": "node --test tests/*.test.js",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies",
    "generate:icon": "node ./scripts/generate-icon.js"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.7.1",
    "@types/node": "^20.19.37",
    "@types/vscode": "^1.109.0",
    "eslint": "^9.39.4",
    "typescript": "^5.9.3"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Database access and file generation require a trusted workspace."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "The metadata bridge and generation require a local filesystem."
    }
  }
}
