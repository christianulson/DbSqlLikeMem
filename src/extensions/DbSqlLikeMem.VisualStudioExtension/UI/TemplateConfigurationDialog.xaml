<Window x:Class="DbSqlLikeMem.VisualStudioExtension.UI.TemplateConfigurationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prop="clr-namespace:DbSqlLikeMem.VisualStudioExtension.Properties"
        Title="{x:Static prop:Resources.TemplateConfigTitle}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Width="720" Height="640" MinWidth="480" MinHeight="360">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{x:Static prop:Resources.CancelButton}" MinWidth="90" Padding="12,6" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="{x:Static prop:Resources.SaveButton}" MinWidth="90" Padding="12,6" IsDefault="True" Click="OnSaveClick" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
            <StackPanel>
                <TextBlock Text="{x:Static prop:Resources.GlobalTemplatesHelp}" TextWrapping="Wrap" Margin="0,0,0,12" />
                <Label Content="{x:Static prop:Resources.TemplateBaselineLabel}" Target="{Binding ElementName=TemplateBaselineProfileComboBox}" Padding="0,0,0,4" />
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="{x:Static prop:Resources.ApplyBaselineButton}" Padding="12,4" Margin="8,0,0,0" Click="OnApplyBaselineClick" />
                    <ComboBox x:Name="TemplateBaselineProfileComboBox" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectionChanged="OnBaselineSelectionChanged" AutomationProperties.Name="{x:Static prop:Resources.TemplateBaselineLabel}" />
                </DockPanel>
                <TextBlock x:Name="BaselineSummaryTextBlock" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock Text="{x:Static prop:Resources.TemplateProfileHelp}" TextWrapping="Wrap" Margin="0,0,0,16" />
                <Label Content="{x:Static prop:Resources.ModelTemplateLabel}" Target="{Binding ElementName=ModelTemplatePathTextBox}" Padding="0,0,0,4" />
                <TextBox x:Name="ModelTemplatePathTextBox" Padding="6,4" Margin="0,0,0,12" AutomationProperties.Name="{x:Static prop:Resources.ModelTemplateLabel}" />
                <Label Content="{x:Static prop:Resources.RepositoryTemplateLabel}" Target="{Binding ElementName=RepositoryTemplatePathTextBox}" Padding="0,0,0,4" />
                <TextBox x:Name="RepositoryTemplatePathTextBox" Padding="6,4" Margin="0,0,0,12" AutomationProperties.Name="{x:Static prop:Resources.RepositoryTemplateLabel}" />
                <Label Content="{x:Static prop:Resources.ModelOutputLabel}" Target="{Binding ElementName=ModelOutputDirectoryTextBox}" Padding="0,0,0,4" />
                <TextBox x:Name="ModelOutputDirectoryTextBox" Padding="6,4" Margin="0,0,0,12" AutomationProperties.Name="{x:Static prop:Resources.ModelOutputLabel}" />
                <Label Content="{x:Static prop:Resources.RepositoryOutputLabel}" Target="{Binding ElementName=RepositoryOutputDirectoryTextBox}" Padding="0,0,0,4" />
                <TextBox x:Name="RepositoryOutputDirectoryTextBox" Padding="6,4" Margin="0,0,0,12" AutomationProperties.Name="{x:Static prop:Resources.RepositoryOutputLabel}" />
                <Label Content="{x:Static prop:Resources.ModelFilePatternLabel}" Target="{Binding ElementName=ModelFileNamePatternTextBox}" Padding="0,0,0,4" />
                <TextBox x:Name="ModelFileNamePatternTextBox" Padding="6,4" Margin="0,0,0,12" AutomationProperties.Name="{x:Static prop:Resources.ModelFilePatternLabel}" />
                <Label Content="{x:Static prop:Resources.RepositoryFilePatternLabel}" Target="{Binding ElementName=RepositoryFileNamePatternTextBox}" Padding="0,0,0,4" />
                <TextBox x:Name="RepositoryFileNamePatternTextBox" Padding="6,4" Margin="0,0,0,12" AutomationProperties.Name="{x:Static prop:Resources.RepositoryFilePatternLabel}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
