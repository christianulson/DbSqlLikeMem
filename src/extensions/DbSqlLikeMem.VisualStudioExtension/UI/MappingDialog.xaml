<Window x:Class="DbSqlLikeMem.VisualStudioExtension.UI.MappingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prop="clr-namespace:DbSqlLikeMem.VisualStudioExtension.Properties"
        Title="{x:Static prop:Resources.MappingDialogTitle}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Width="640" Height="480" MinWidth="480" MinHeight="360">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{x:Static prop:Resources.CancelButton}" MinWidth="90" Padding="12,6" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="{x:Static prop:Resources.SaveButton}" MinWidth="90" Padding="12,6" IsDefault="True" Click="OnSaveClick" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
            <StackPanel>
                <Label Content="{x:Static prop:Resources.MappingBaselineLabel}" Target="{Binding ElementName=TemplateBaselineProfileComboBox}" Padding="0,0,0,4" />
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="{x:Static prop:Resources.ApplyBaselineButton}" Padding="12,4" Margin="8,0,0,0" Click="OnApplyBaselineClick" />
                    <ComboBox x:Name="TemplateBaselineProfileComboBox" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectionChanged="OnBaselineSelectionChanged" AutomationProperties.Name="{x:Static prop:Resources.MappingBaselineLabel}" />
                </DockPanel>
                <TextBlock x:Name="BaselineSummaryTextBlock" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock Text="{x:Static prop:Resources.MappingProfileHelp}" TextWrapping="Wrap" Margin="0,0,0,16" />
                <Label Content="{x:Static prop:Resources.FilePatternLabel}" Target="{Binding ElementName=FilePatternTextBox}" Padding="0,0,0,4" />
                <TextBox x:Name="FilePatternTextBox" Padding="6,4" Margin="0,0,0,12" AutomationProperties.Name="{x:Static prop:Resources.FilePatternLabel}" />
                <Label Content="{x:Static prop:Resources.OutputDirectoryLabel}" Target="{Binding ElementName=OutputDirectoryTextBox}" Padding="0,0,0,4" />
                <TextBox x:Name="OutputDirectoryTextBox" Padding="6,4" Margin="0,0,0,12" AutomationProperties.Name="{x:Static prop:Resources.OutputDirectoryLabel}" />
                <Label Content="{x:Static prop:Resources.NamespaceOptionalLabel}" Target="{Binding ElementName=NamespaceTextBox}" Padding="0,0,0,4" />
                <TextBox x:Name="NamespaceTextBox" Padding="6,4" Margin="0,0,0,12" AutomationProperties.Name="{x:Static prop:Resources.NamespaceOptionalLabel}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
