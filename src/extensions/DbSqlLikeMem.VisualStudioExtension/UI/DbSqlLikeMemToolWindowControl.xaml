<UserControl x:Class="DbSqlLikeMem.VisualStudioExtension.UI.DbSqlLikeMemToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prop="clr-namespace:DbSqlLikeMem.VisualStudioExtension.Properties"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:theming="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:utilities="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Utilities"
             xmlns:ui="clr-namespace:DbSqlLikeMem.VisualStudioExtension.UI"
             xmlns:vs="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             Background="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
             Foreground="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}"
             x:Name="RootControl"
             mc:Ignorable="d"
             d:DesignHeight="480"
             d:DesignWidth="420">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <utilities:BrushToColorConverter x:Key="BrushToColorConverter" />
        <Style x:Key="ToolbarIconStyle" TargetType="{x:Type imaging:CrispImage}">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="ContextIconStyle" TargetType="{x:Type imaging:CrispImage}">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type ui:ExplorerNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" ToolTip="{Binding HealthMessage}">
                <TextBlock Text="{Binding NodeGlyph}" Margin="0,0,6,0" />
                <TextBlock Text="{Binding StatusGlyph}" Margin="0,0,6,0" />
                <TextBlock Text="{Binding Label}" />
            </StackPanel>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Grid Margin="8"
          theming:ImageThemingUtilities.ImageBackgroundColor="{Binding Background, ElementName=RootControl, Converter={StaticResource BrushToColorConverter}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Orientation="Horizontal">
            <WrapPanel.Style>
                <Style TargetType="WrapPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </WrapPanel.Style>
            <Button Padding="10,4" MinWidth="156" Margin="0,0,8,8" Click="OnAddConnectionClick">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <imaging:CrispImage Style="{StaticResource ToolbarIconStyle}" Moniker="{x:Static catalog:KnownMonikers.Add}" />
                    <TextBlock Text="{x:Static prop:Resources.AddConnectionButton}" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
            <Button Padding="10,4" Margin="0,0,8,8" Click="OnRefreshAllObjectsClick" ToolTip="{x:Static prop:Resources.RefreshAllConnectionsLabel}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <imaging:CrispImage Style="{StaticResource ToolbarIconStyle}" Moniker="{x:Static catalog:KnownMonikers.Rerun}" />
                    <TextBlock Text="{x:Static prop:Resources.RefreshAllConnectionsLabel}" />
                </StackPanel>
            </Button>
            <Button Padding="10,4" Margin="0,0,8,8" Click="OnConfigureTemplatesClick" ToolTip="{x:Static prop:Resources.GlobalTemplatesHelp}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <imaging:CrispImage Style="{StaticResource ToolbarIconStyle}" Moniker="{x:Static catalog:KnownMonikers.Settings}" />
                    <TextBlock Text="{x:Static prop:Resources.ConfigureTemplatesMenu}" />
                </StackPanel>
            </Button>
            <Button Padding="10,4" Margin="0,0,8,8" Click="OnImportSettingsClick">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <imaging:CrispImage Style="{StaticResource ToolbarIconStyle}" Moniker="{x:Static catalog:KnownMonikers.ImportSettings}" />
                    <TextBlock Text="{x:Static prop:Resources.ImportSettingsButton}" />
                </StackPanel>
            </Button>
            <Button Padding="10,4" Margin="0,0,8,8" Click="OnExportSettingsClick">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <imaging:CrispImage Style="{StaticResource ToolbarIconStyle}" Moniker="{x:Static catalog:KnownMonikers.VisualStudioDownload}" />
                    <TextBlock Text="{x:Static prop:Resources.ExportSettingsButton}" />
                </StackPanel>
            </Button>
            <TextBox x:Name="GlobalFilterTextBox"
                     MinWidth="140"
                     Margin="0,0,8,8"
                     Padding="4,3"
                     VerticalAlignment="Center"
                     ToolTip="{x:Static prop:Resources.GlobalFilterToolTip}"
                     AutomationProperties.Name="{x:Static prop:Resources.GlobalFilterToolTip}"
                     TextChanged="OnGlobalFilterTextChanged" />
            <ComboBox x:Name="GlobalFilterModeComboBox"
                      MinWidth="76"
                      Margin="0,0,8,8"
                      VerticalAlignment="Center"
                      SelectionChanged="OnGlobalFilterModeChanged"
                      AutomationProperties.Name="{x:Static prop:Resources.GlobalFilterModeLabel}" />
            <Button x:Name="ClearGlobalFilterButton"
                    Padding="6,3"
                    Margin="0,0,8,8"
                    VerticalAlignment="Center"
                    Content="✕"
                    Click="OnClearGlobalFilterClick"
                    ToolTip="{x:Static prop:Resources.ClearGlobalFilterToolTip}"
                    AutomationProperties.Name="{x:Static prop:Resources.ClearGlobalFilterToolTip}"
                    Visibility="Collapsed" />
        </WrapPanel>

        <Grid Grid.Row="2">
            <TreeView x:Name="ExplorerTree"
                      PreviewMouseRightButtonDown="OnExplorerTreePreviewMouseRightButtonDown"
                      SelectedItemChanged="OnExplorerTreeSelectedItemChanged"
                      ItemsSource="{Binding Nodes}">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <EventSetter Event="Expanded" Handler="OnExplorerTreeItemExpanded" />
                        <EventSetter Event="Collapsed" Handler="OnExplorerTreeItemCollapsed" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ContextMenu>
                    <ContextMenu Opened="OnExplorerContextMenuOpened">
                        <MenuItem x:Name="EditConnectionMenuItem" Header="{x:Static prop:Resources.EditConnectionMenu}" Click="OnEditConnectionClick">
                            <MenuItem.Icon>
                                <imaging:CrispImage Style="{StaticResource ContextIconStyle}" Moniker="{x:Static catalog:KnownMonikers.EditQuery}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="RefreshConnectionMenuItem" Header="{x:Static prop:Resources.RefreshConnectionLabel}" Click="OnRefreshObjectsClick">
                            <MenuItem.Icon>
                                <imaging:CrispImage Style="{StaticResource ContextIconStyle}" Moniker="{x:Static catalog:KnownMonikers.Rerun}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="CancelConnectionOperationMenuItem" Header="{x:Static prop:Resources.CancelOperationMenu}" Click="OnCancelOperationClick">
                            <MenuItem.Icon>
                                <imaging:CrispImage Style="{StaticResource ContextIconStyle}" Moniker="{x:Static catalog:KnownMonikers.StopFilter}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="RemoveConnectionMenuItem" Header="{x:Static prop:Resources.RemoveConnectionMenu}" Click="OnRemoveConnectionClick">
                            <MenuItem.Icon>
                                <imaging:CrispImage Style="{StaticResource ContextIconStyle}" Moniker="{x:Static catalog:KnownMonikers.DeleteEntity}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator x:Name="ConnectionActionsSeparator" />
                        <MenuItem x:Name="ConfigureMappingsMenuItem" Header="{x:Static prop:Resources.ConfigureMappingsMenu}" Click="OnConfigureMappingsClick">
                            <MenuItem.Icon>
                                <imaging:CrispImage Style="{StaticResource ContextIconStyle}" Moniker="{x:Static catalog:KnownMonikers.Settings}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="ConfigureTemplatesMenuItem" Header="{x:Static prop:Resources.ConfigureTemplatesMenu}" Click="OnConfigureTemplatesClick">
                            <MenuItem.Icon>
                                <imaging:CrispImage Style="{StaticResource ContextIconStyle}" Moniker="{x:Static catalog:KnownMonikers.Settings}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="ConfigureObjectTypeFilterMenuItem" Header="{x:Static prop:Resources.FilterItemsMenu}" Click="OnConfigureObjectTypeFilterClick">
                            <MenuItem.Icon>
                                <imaging:CrispImage Style="{StaticResource ContextIconStyle}" Moniker="{x:Static catalog:KnownMonikers.EditFilter}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="ClearObjectTypeFilterMenuItem" Header="{x:Static prop:Resources.ClearFilterMenu}" Click="OnClearObjectTypeFilterClick">
                            <MenuItem.Icon>
                                <imaging:CrispImage Style="{StaticResource ContextIconStyle}" Moniker="{x:Static catalog:KnownMonikers.Remove}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator x:Name="GenerationActionsSeparator" />
                        <MenuItem x:Name="GenerateAllClassesMenuItem" Header="{x:Static prop:Resources.GenerateAllClassesMenu}" Click="OnGenerateAllClassesClick">
                            <MenuItem.Icon>
                                <imaging:CrispImage Style="{StaticResource ContextIconStyle}" Moniker="{x:Static catalog:KnownMonikers.CodeInformation}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator x:Name="GenerateByTypeSeparator" />
                        <MenuItem x:Name="GenerateTestClassesMenuItem" Header="{x:Static prop:Resources.GenerateTestClassesMenu}" Click="OnGenerateClassesClick">
                            <MenuItem.Icon>
                                <imaging:CrispImage Style="{StaticResource ContextIconStyle}" Moniker="{x:Static catalog:KnownMonikers.Run}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="GenerateModelClassesMenuItem" Header="{x:Static prop:Resources.GenerateModelClassesMenu}" Click="OnGenerateModelClassesClick">
                            <MenuItem.Icon>
                                <imaging:CrispImage Style="{StaticResource ContextIconStyle}" Moniker="{x:Static catalog:KnownMonikers.Property}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="GenerateRepositoryClassesMenuItem" Header="{x:Static prop:Resources.GenerateRepositoryClassesMenu}" Click="OnGenerateRepositoryClassesClick">
                            <MenuItem.Icon>
                                <imaging:CrispImage Style="{StaticResource ContextIconStyle}" Moniker="{x:Static catalog:KnownMonikers.Output}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="CheckConsistencyMenuItem" Header="{x:Static prop:Resources.CheckConsistencyMenu}" Click="OnCheckConsistencyClick">
                            <MenuItem.Icon>
                                <imaging:CrispImage Style="{StaticResource ContextIconStyle}" Moniker="{x:Static catalog:KnownMonikers.Analysis}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="ExtractScenarioMenuItem" Header="{x:Static prop:Resources.ExtractTestScenarioMenu}" Click="OnExtractScenarioClick">
                            <MenuItem.Icon>
                                <imaging:CrispImage Style="{StaticResource ContextIconStyle}" Moniker="{x:Static catalog:KnownMonikers.Run}" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </TreeView.ContextMenu>
            </TreeView>

            <Border Background="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="260"
                        Margin="12"
                        Padding="12"
                        Background="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
                        CornerRadius="10">
                    <StackPanel HorizontalAlignment="Center">
                        <ProgressBar MaxWidth="220"
                                     Height="10"
                                     IsIndeterminate="True"
                                     Margin="0,0,0,12" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontWeight="SemiBold" />
                        <Button Content="{x:Static prop:Resources.CancelButton}" Padding="12,6" Margin="0,12,0,0" Click="OnCancelOperationClick" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <Border Grid.Row="3" Margin="0,8,0,0" Padding="6" Background="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowBackgroundBrushKey}}" CornerRadius="4">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
